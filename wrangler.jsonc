{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yumemita-stream-dashboard",
  // 源配置：adapter 会生成 dist/server/wrangler.json，部署必须用那份。
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "yumemita-data"
    }
  ],
  // Workers Cache：首版关闭跨版本复用，部署后从冷缓存开始。
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  }
}
