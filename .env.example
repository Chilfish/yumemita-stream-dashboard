# 数据源根地址（Cloudflare R2 / S3 兼容存储）。构建时注入，前端按需请求单场数据。
# 布局：<base>/<datasetId>/manifest.json
#       <base>/<datasetId>/insights.json
#       <base>/<datasetId>/<videoId>.datapack.json
# 留空则回退到本地 data/（离线开发用）。
VITE_DATAPACK_BASE=

# 以下仅 bun run publish:data 本地发布时需要，构建不需要。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
