# Neon PostgreSQL（Worker 读路径与 ingest 共用）
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 本地模式总开关：数据库、对象存储、媒体地址全部走本机（见 docs/engineering/local-database.md）。
# `bun run dev --local` 会开启并写回 .env.local；手动加这一行也可以。
# LOCAL=1

# 本地对象存储（SILO，MinIO 的维护分支）；只在 LOCAL=1 时生效。
# 默认值即下面这组，通常不用写。
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=silo-admin
# S3_SECRET_ACCESS_KEY=silo-admin
# SILO_DATA=temp/silo-data

# 本地开发：workerd 不能直连 TCP，页面读路径经本地 /sql 代理。
# `bun run dev` 会在 .dev.vars（不是 .env）里自动补 DATABASE_URL 与下面这行；
# 本地脚本直接读 .env.local 的 DATABASE_URL。
# NEON_HTTP_ENDPOINT=http://127.0.0.1:4444/sql

# Cloudflare R2（脚本发布资产；Worker 通过 wrangler 的 r2_buckets 绑定读取）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yumemita-data
# 桶内已无公共前缀；对象直接放在桶根（archive/、<datasetId>/thumbs/、emojis/ …）。
R2_PREFIX=

# 封面 / 表情的 R2 公开域名，构建时内联到客户端
PUBLIC_R2_BASE=

# Worker 站点根地址（脚本调用 purge 端点用）；也是 canonical / sitemap 的默认值
SITE_URL=https://ymmt.chilfish.top

# 内部缓存失效端点令牌
PURGE_TOKEN=
