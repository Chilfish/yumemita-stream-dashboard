# Neon PostgreSQL（Worker 读路径与 ingest 共用）
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 本地开发：workerd 不能直连 TCP，需运行 bun run dev:db:proxy 并指向它。
# 放在 .dev.vars（不是 .env）；本地脚本直接用 .env.local 的 DATABASE_URL。
# NEON_HTTP_ENDPOINT=http://127.0.0.1:4444/sql

# Cloudflare R2（脚本发布资产；Worker 通过 wrangler 的 r2_buckets 绑定读取）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yumemita-data
# 桶内已无公共前缀；对象直接放在桶根（archive/、<datasetId>/thumbs/、emojis/ …）。
R2_PREFIX=

# 封面 / 表情的 R2 公开域名，构建时内联到客户端
PUBLIC_R2_BASE=

# Worker 站点根地址（脚本调用 purge 端点用）；也是 canonical / sitemap 的默认值
SITE_URL=https://ymmt.chilfish.top

# 内部缓存失效端点令牌
PURGE_TOKEN=
