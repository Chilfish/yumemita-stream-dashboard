# Neon PostgreSQL（Worker 读路径与 ingest 共用）
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2（脚本发布资产；Worker 通过 wrangler 的 r2_buckets 绑定读取）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=

# 封面 / 表情的 R2 公开域名，供浏览器直接访问
PUBLIC_R2_BASE=

# 内部缓存失效端点令牌
PURGE_TOKEN=

# 迁移期兼容：旧发布脚本仍读这两个变量；页面不再依赖它们。
VITE_DATAPACK_BASE=
VITE_SITE_URL=
