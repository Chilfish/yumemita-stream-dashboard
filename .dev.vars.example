# 本地 Cloudflare workerd 开发环境使用 .dev.vars
# 复制为 .dev.vars 后填入真实值
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yumemita-data
# 桶内已无公共前缀；对象直接放在桶根（archive/、<datasetId>/thumbs/、emojis/ …）。
R2_PREFIX=

PUBLIC_R2_BASE=
SITE_URL=https://ymmt.chilfish.top

PURGE_TOKEN=
MEMBER_ONLY_KEY=
