---
import type { SeoMeta } from '@/lib/seo'
import { ClientRouter } from 'astro:transitions'
import { ProgressBar } from '@/components/shared/progress-bar'
import SEO from '@/components/shared/SEO.astro'
import { ThemeProvider } from '@/components/shared/ThemeProvider'
import '@/styles/app.css'

interface Props {
  meta: SeoMeta
  lang?: string
  alternateMarkdown?: string
}

const { meta, lang = 'zh-CN', alternateMarkdown } = Astro.props
// 封面与表情在独立域名上，首屏最大的图要等一次 DNS + TLS；提前握手。
const assetOrigin = (import.meta.env.PUBLIC_R2_BASE ?? '').replace(/\/+$/, '')
// `rel="describedby"` 要绝对地址；子路径部署时还要带上 BASE_URL 前缀。
const llmsHref = new URL(`${import.meta.env.BASE_URL}llms.txt`, Astro.site ?? Astro.url).href
---

<!doctype html>
<html lang={lang} class="touch-manipulation overflow-x-hidden overflow-y-scroll [scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta content="#f5f2f4" media="(prefers-color-scheme: light)" name="theme-color" />
    <meta content="#0b0b0c" media="(prefers-color-scheme: dark)" name="theme-color" />
    <meta name="application-name" content="ゆめみた 配信数据台" />

    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {assetOrigin && (
      <>
        <link rel="preconnect" href={assetOrigin} crossorigin />
        <link rel="dns-prefetch" href={assetOrigin} />
      </>
    )}
    {alternateMarkdown && (
      <link rel="alternate" type="text/markdown" href={alternateMarkdown} />
    )}
    <!-- llms.txt v2：声明覆盖本站的 Agent 描述文件，任意页面都能被找到。 -->
    <link rel="describedby" type="text/plain" href={llmsHref} />

    <SEO meta={meta} />
    <ClientRouter />

    <script is:inline>
      ;(function () {
        // 旧版本的 `#/nonoka/...` 链接在启动前改写成真实路径。
        if (location.hash.startsWith('#/')) {
          location.replace(location.hash.slice(1))
          return
        }
        function applyTheme() {
          const root = document.documentElement
          root.classList.remove('light', 'dark')
          try {
            const raw = localStorage.getItem('app-config-store')
            const theme = raw ? JSON.parse(raw).state.theme : 'system'
            root.classList.add(theme === 'system'
              ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
              : theme)
          }
          catch {
            root.classList.add('light')
          }
        }
        applyTheme()
        // ClientRouter 换页时用服务端输出的 <html class> 覆盖根属性，会把运行时加的主题类抹掉。
        // 每次交换后重新套用一次，避免站内跳转后回到浅色。
        document.addEventListener('astro:after-swap', applyTheme)
      })()
    </script>
  </head>
  <body>
    <ProgressBar client:load transition:persist />
    <ThemeProvider client:load transition:persist />
    <slot />
  </body>
</html>
