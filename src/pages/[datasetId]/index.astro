---
import Layout from '@/layouts/Layout.astro'
import ErrorState from '@/components/shared/ErrorState.astro'
import { DatasetPage } from '@/components/app/dataset-page'
import { db } from '@/db/client'
import { getDatasetPageData } from '@/db/queries/view-data'
import { pageSeo, requestParams, requestSearch } from '@/lib/page'
import { isMemberOnly } from '@/lib/visibility'

export const prerender = false

const datasetId = Astro.params.datasetId!
let failed = false
const data = await getDatasetPageData(db, datasetId).catch(error => {
  console.error('[page] dataset home failed', error)
  failed = true
  return null
})

const latest = data?.rows.find(row => !isMemberOnly(row.availability)) ?? null
if (failed) Astro.response.status = 500
else if (!data) {
  Astro.response.status = 404
  Astro.cache.set({ maxAge: 60, swr: 300, tags: [`dataset-${datasetId}`] })
}
else Astro.cache.set({ maxAge: 3600, swr: 86400, tags: [`dataset-${datasetId}`] })

const meta = data
  ? pageSeo(Astro, {
      section: 'home',
      dataset: { id: data.dataset.id, label: data.dataset.label, count: data.dataset.count },
      streamCount: data.rows.length,
      memberCount: data.datasets.length,
      updatedAt: latest?.startedAt ?? null,
      imageStream: latest ? { datasetId: data.dataset.id, videoId: latest.videoId } : null,
    })
  : pageSeo(Astro, { section: 'home', dataset: null, notFound: true })
---

<Layout meta={meta}>
  {data
    ? (
        <DatasetPage
          client:idle
          comparePacks={{}}
          dataset={data.dataset}
          datasets={data.datasets}
          pack={null}
          params={requestParams(Astro)}
          pathname={Astro.url.pathname}
          rows={data.rows}
          search={requestSearch(Astro)}
          section="home"
          stream={null}
          totals={data.totals}
          view="home"
        />
      )
    : (
        <ErrorState
          code={failed ? '500' : '404'}
          title={failed ? '数据读取失败' : '找不到这位成员'}
          detail={failed ? '可以刷新重试；其他页面不受影响。' : '成员 id 可能写错了，或者还没有导入数据。'}
        />
      )}
</Layout>
