---
import Layout from '@/layouts/Layout.astro'
import ErrorState from '@/components/shared/ErrorState.astro'
import { DatasetPage } from '@/components/app/dataset-page'
import { db } from '@/db/client'
import { getStreamPageData, getStreamPageExtras } from '@/db/queries/view-data'
import { memberOnlyCachePolicy } from '@/lib/member-access'
import { pageSeo, requestParams, requestSearch } from '@/lib/page'
import { isMemberOnly } from '@/lib/visibility'
import type { StreamSummary } from '@/types/dataset'

export const prerender = false

const datasetId = Astro.params.datasetId!
const videoId = Astro.params.videoId!
const { unlocked, keyed, configured } = memberOnlyCachePolicy(Astro)

let failed = false
const data = await getStreamPageData(db, datasetId, videoId).catch(error => {
  console.error('[page] stream failed', error)
  failed = true
  return null
})

const summary = data?.summary ?? null
// 会员限定场的封面、标题与时间公开，弹幕 / 评论 / SC 等明细要带访问参数才放行。
const memberOnly = summary !== null && isMemberOnly(summary.availability)
const misconfigured = memberOnly && !configured
const locked = memberOnly && configured && !unlocked
const blocked = locked || misconfigured

// 锁定页不渲染子视图；清掉 URL 里的 view，避免地址与页面状态不一致。
if (locked && Astro.url.searchParams.has("view")) {
  const url = new URL(Astro.url)
  url.searchParams.delete("view")
  return Astro.redirect(`${url.pathname}${url.search}`, 302)
}

// 第二轮：逐字稿元数据 + pack 在同一个 batch（1 次 HTTP 请求）。
const extras = summary && !blocked
  ? await getStreamPageExtras(db, datasetId, videoId, data?.neighborIds ?? [])
  : null
const transcript = extras?.transcript ?? null
const pack = extras?.pack ?? null
const hasTranscript = Boolean(transcript)
const neighborById = new Map((extras?.neighbors ?? []).map(item => [item.videoId, item]))
const rows: StreamSummary[] = []
if (data && summary) {
  const newer = data.neighborIds[0] ? neighborById.get(data.neighborIds[0]) : undefined
  const older = data.neighborIds[1] ? neighborById.get(data.neighborIds[1]) : undefined
  for (const item of [newer, summary, older]) if (item) rows.push(item)
}

if (misconfigured) {
  Astro.response.status = 503
}
else if (locked) {
  if (!keyed) Astro.cache.set({ maxAge: 3600, swr: 86400, tags: [`stream-${videoId}`, `dataset-${datasetId}`] })
}
else if (!data || !summary) {
  Astro.response.status = failed ? 500 : 404
  if (!failed) {
    Astro.cache.set({ maxAge: 60, swr: 300, tags: [`stream-${videoId}`, `dataset-${datasetId}`] })
  }
}
else if (!keyed) {
  Astro.cache.set({ maxAge: 3600, swr: 86400, tags: [`stream-${videoId}`, `dataset-${datasetId}`] })
}

const datasetLabel = data?.dataset.label ?? datasetId
const baseMeta = blocked && summary
  ? pageSeo(Astro, {
      section: 'stream',
      dataset: { id: datasetId, label: datasetLabel, count: data?.dataset.count },
      stream: {
        videoId: summary.videoId,
        title: summary.title,
        startedAt: summary.startedAt,
        durationSec: null,
        avgConcurrent: null,
        maxConcurrent: null,
        chatTotal: null,
        superchats: null,
      },
      streamCount: data?.navItems.length ?? null,
      memberCount: data?.datasets.length ?? null,
      updatedAt: summary.startedAt,
      imageStream: { datasetId, videoId },
    })
  : data && summary
    ? pageSeo(Astro, {
        section: 'stream',
        dataset: { id: data.dataset.id, label: data.dataset.label, count: data.dataset.count },
        stream: {
          videoId: summary.videoId,
          title: summary.title,
          startedAt: summary.startedAt,
          durationSec: summary.durationSec,
          avgConcurrent: summary.avgConcurrent,
          maxConcurrent: summary.maxConcurrent,
          chatTotal: summary.chatTotal,
          superchats: summary.superchats,
        },
        streamCount: data.navItems.length,
        memberCount: data.datasets.length,
        updatedAt: summary.startedAt,
        imageStream: { datasetId, videoId },
      })
    : pageSeo(Astro, {
        section: 'stream',
        dataset: data
          ? { id: data.dataset.id, label: data.dataset.label, count: data.dataset.count }
          : null,
        stream: null,
        notFound: true,
      })

const meta = blocked
  ? {
      ...baseMeta,
      description: '这是一场会员限定直播。本站只展示封面与标题，不公开弹幕、SC、评论与统计数据。',
      robots: 'noindex,follow' as const,
      jsonLd: [],
    }
  : baseMeta

// 不把访问参数写进 HTML：它会进入历史记录与 Referer。需要 Markdown 正文时由请求方自行带上参数。
const markdownHref = summary && !blocked
  ? `/${datasetId}/stream/${videoId}.md`
  : undefined
---

<Layout
  alternateMarkdown={markdownHref}
  meta={meta}
>
  {misconfigured
    ? (
        <ErrorState
          code="503"
          title="会员限定访问未配置"
          detail="这项内容需要访问参数。请让站点管理员检查配置后重试。"
        />
      )
    : data && summary
    ? (
        <DatasetPage
          client:idle
          compareDensities={{}}
          dataset={data.dataset}
          datasets={data.datasets}
          hasTranscript={hasTranscript}
          locked={locked}
          navItems={data.navItems}
          pack={pack}
          params={requestParams(Astro)}
          pathname={Astro.url.pathname}
          rows={rows}
          search={requestSearch(Astro)}
          section="stream"
          stream={summary}
          totals={data.totals}
          view="stream"
        />
      )
    : (
        <ErrorState
          code={failed ? '500' : '404'}
          title={failed ? '数据读取失败' : '找不到这场直播'}
          detail={failed ? '可以刷新重试；场次列表和相册不受影响。' : '它可能已被删除，或从未被本站收录。'}
        />
      )}
</Layout>
