---
import Layout from '@/layouts/Layout.astro'
import ErrorState from '@/components/shared/ErrorState.astro'
import LockedStream from '@/components/shared/LockedStream.astro'
import { DatasetPage } from '@/components/app/dataset-page'
import { db } from '@/db/client'
import { getStreamPack } from '@/db/queries/packs'
import { getStream } from '@/db/queries/streams'
import { getTranscriptMeta } from '@/db/queries/transcripts'
import { getDatasetPageData } from '@/db/queries/view-data'
import { memberOnlyCachePolicy } from '@/lib/member-access'
import { pageSeo, requestParams, requestSearch } from '@/lib/page'
import { isMemberOnly } from '@/lib/visibility'

export const prerender = false

const datasetId = Astro.params.datasetId!
const videoId = Astro.params.videoId!
const { unlocked, keyed } = memberOnlyCachePolicy(Astro)

const data = await getDatasetPageData(db, datasetId, { includeMemberOnly: unlocked }).catch(error => {
  console.error('[page] stream failed', error)
  return null
})

const summary = data?.rows.find(row => row.videoId === videoId) ?? null
// 列表里没有不代表不存在：可能是被隐藏的会员限定场次，单独查一次判断。
const hidden = summary ? null : await getStream(db, datasetId, videoId).catch(() => null)
const locked = hidden !== null && isMemberOnly(hidden.availability)

// 第三个状态是查询失败：交给客户端索引兜底，而不是当作「没有稿」。
const transcript = summary
  ? await getTranscriptMeta(db, datasetId, videoId).catch(error => {
      console.error('[page] stream transcript lookup failed', error)
      return undefined
    })
  : null

const pack = summary ? await getStreamPack(db, datasetId, videoId).catch(() => null) : null
const hasTranscript = Boolean(transcript)

if (locked) {
  if (!keyed) Astro.cache.set({ maxAge: 300, swr: 600, tags: [`stream-${videoId}`, `dataset-${datasetId}`] })
}
else if (!data || !summary) {
  Astro.response.status = 404
}
else if (!keyed) {
  Astro.cache.set({ maxAge: 300, swr: 600, tags: [`stream-${videoId}`, `dataset-${datasetId}`] })
}

const datasetLabel = data?.dataset.label ?? datasetId
const baseMeta = locked && hidden
  ? pageSeo(Astro, {
      section: 'stream',
      dataset: { id: datasetId, label: datasetLabel, count: data?.dataset.count },
      stream: {
        videoId: hidden.videoId,
        title: hidden.title,
        startedAt: hidden.startedAt,
        durationSec: null,
        avgConcurrent: null,
        maxConcurrent: null,
        chatTotal: null,
        superchats: null,
      },
      streamCount: data?.rows.length ?? null,
      memberCount: data?.datasets.length ?? null,
      updatedAt: hidden.startedAt,
      imageStream: { datasetId, videoId },
    })
  : data && summary
    ? pageSeo(Astro, {
        section: 'stream',
        dataset: { id: data.dataset.id, label: data.dataset.label, count: data.dataset.count },
        stream: {
          videoId: summary.videoId,
          title: summary.title,
          startedAt: summary.startedAt,
          durationSec: summary.durationSec,
          avgConcurrent: summary.avgConcurrent,
          maxConcurrent: summary.maxConcurrent,
          chatTotal: summary.chatTotal,
          superchats: summary.superchats,
        },
        streamCount: data.rows.length,
        memberCount: data.datasets.length,
        updatedAt: summary.startedAt,
        imageStream: { datasetId, videoId },
      })
    : pageSeo(Astro, {
        section: 'stream',
        dataset: data
          ? { id: data.dataset.id, label: data.dataset.label, count: data.dataset.count }
          : null,
        stream: null,
        notFound: true,
      })

const meta = locked
  ? {
      ...baseMeta,
      description: '这是一场会员限定直播。本站只展示封面与标题，不公开弹幕、SC、评论与统计数据。',
      robots: 'noindex,follow' as const,
      jsonLd: [],
    }
  : baseMeta

// 解锁后的 Markdown 视图保留 key，否则同源链接会立刻掉回锁定版。
const markdownHref = summary
  ? `/${datasetId}/stream/${videoId}.md${keyed ? `?key=${encodeURIComponent(Astro.url.searchParams.get('key') ?? '')}` : ''}`
  : undefined
---

<Layout
  alternateMarkdown={markdownHref}
  meta={meta}
>
  {locked && hidden
    ? (
        <LockedStream
          datasetId={datasetId}
          datasetLabel={datasetLabel}
          date={hidden.date}
          title={hidden.title}
          videoId={hidden.videoId}
        />
      )
    : data && summary
      ? (
          <DatasetPage
            client:idle
            comparePacks={{}}
            dataset={data.dataset}
            datasets={data.datasets}
            hasTranscript={hasTranscript}
            pack={pack}
            params={requestParams(Astro)}
            pathname={Astro.url.pathname}
            rows={data.rows}
            search={requestSearch(Astro)}
            section="stream"
            stream={summary}
            totals={data.totals}
            view="stream"
          />
        )
      : <ErrorState code="404" title="找不到这场直播" detail="它可能已被删除，或从未被本站收录。" />}
</Layout>
