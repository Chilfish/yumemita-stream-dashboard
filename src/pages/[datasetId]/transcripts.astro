---
import Layout from '@/layouts/Layout.astro'
import ErrorState from '@/components/shared/ErrorState.astro'
import { DatasetPage } from '@/components/app/dataset-page'
import { db } from '@/db/client'
import { getTranscriptIndex } from '@/db/queries/transcripts'
import { getDatasetPageData } from '@/db/queries/view-data'
import { pageSeo, requestParams, requestSearch } from '@/lib/page'
import { memberOnlyCachePolicy } from '@/lib/member-access'

export const prerender = false

const datasetId = Astro.params.datasetId!
const { unlocked, keyed } = memberOnlyCachePolicy(Astro)
const [data, transcriptResult] = await Promise.all([
  getDatasetPageData(db, datasetId, { includeMemberOnly: unlocked }).catch(error => {
    console.error('[page] transcripts failed', error)
    return null
  }),
  getTranscriptIndex(db, datasetId, { includeMemberOnly: unlocked })
    .then(entries => ({ entries, error: null as string | null }))
    .catch(error => {
      console.error('[page] transcripts index failed', error)
      return {
        entries: [],
        error: error instanceof Error ? error.message : String(error),
      }
    }),
])
if (!data) Astro.response.status = 404
else if (!keyed) Astro.cache.set({ maxAge: 300, swr: 600, tags: [`dataset-${datasetId}`, 'transcripts'] })

const latest = data?.rows[0] ?? null
const meta = data
  ? pageSeo(Astro, {
      section: 'transcripts',
      dataset: { id: data.dataset.id, label: data.dataset.label, count: data.dataset.count },
      streamCount: data.rows.length,
      memberCount: data.datasets.length,
      updatedAt: latest?.startedAt ?? null,
      imageStream: latest ? { datasetId: data.dataset.id, videoId: latest.videoId } : null,
    })
  : pageSeo(Astro, { section: 'transcripts', dataset: null, notFound: true })
---

<Layout meta={meta}>
  {data
    ? (
        <DatasetPage
          client:idle
          comparePacks={{}}
          dataset={data.dataset}
          datasets={data.datasets}
          pack={null}
          params={requestParams(Astro)}
          pathname={Astro.url.pathname}
          rows={data.rows}
          search={requestSearch(Astro)}
          section="transcripts"
          stream={null}
          totals={data.totals}
          transcriptError={transcriptResult.error}
          transcripts={transcriptResult.entries}
          view="transcripts"
        />
      )
    : <ErrorState code="404" title="找不到这位成员" detail="成员 id 可能写错了，或者还没有导入数据。" />}
</Layout>
