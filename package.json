{
  "name": "yumemita-stream-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "夢限大みゅーたいぷ 成员直播数据的可视化数据台（Astro + coss ui + D3）",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:preview": "astro build && astro preview",
    "cf:deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "bun scripts/smoke-routes.mjs",
    "perf:smoke": "bun scripts/perf-smoke.ts",
    "lint": "oxlint src scripts",
    "check": "bun run typecheck && bun run test && bun run lint",
    "ci": "bun run check && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:ingest": "bun scripts/ingest-db.ts",
    "db:verify": "bun scripts/verify-db.ts",
    "db:query": "bun scripts/db-query-smoke.ts",
    "db:latest": "bun scripts/db-latest-video.ts",
    "publish:data": "bun scripts/publish-data.ts",
    "publish:assets": "bun scripts/publish-data.ts --assets-only",
    "purge:cache": "bun scripts/purge-cache.ts",
    "validate:data": "bun scripts/validate-data.mjs",
    "verify:data": "bun scripts/verify-data.ts",
    "add:datapack": "bun scripts/add-datapack.mjs",
    "fetch:streams": "bun scripts/fetch-streams.ts",
    "fetch:thumbs": "bun scripts/fetch-thumbnails.ts",
    "fetch:emoji": "bun scripts/fetch-emoji.ts",
    "fetch:live-chat": "bun scripts/fetch-live-chat.ts",
    "transcript:import": "bun scripts/transcript-import.ts",
    "transcript:new": "bun scripts/transcript-new.ts",
    "publish:transcripts": "bun scripts/publish-transcripts.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/react": "^7.1.2",
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/bun": "^1.4.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.50.0"
  }
}
