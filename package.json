{
  "name": "yumemita-stream-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "夢限大みゅーたいぷ 成员直播数据的可视化数据台（React + coss ui + D3）",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "bun run sync:data && vite",
    "build": "bun run sync:data && tsc -b && vite build",
    "preview": "vite preview",
    "sync:data": "bun scripts/sync-data.mjs",
    "validate:data": "bun scripts/validate-data.mjs",
    "add:datapack": "bun scripts/add-datapack.mjs",
    "fetch:streams": "bun scripts/fetch-streams.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "bun scripts/smoke-routes.mjs",
    "lint": "oxlint src scripts",
    "check": "bun run typecheck && bun run test && bun run lint",
    "ci": "bun run sync:data && bun run validate:data && bun run check && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.7.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
