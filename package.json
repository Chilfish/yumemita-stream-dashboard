{
  "name": "yumemita-stream-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "夢限大みゅーたいぷ 成员直播数据的可视化数据台（Astro + coss ui + D3）",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "ymmt": "bun scripts/cli.ts",
    "dev": "bun scripts/cli.ts dev server",
    "dev:db": "bun scripts/cli.ts dev db",
    "build": "astro build",
    "preview": "astro preview",
    "cf:preview": "astro build && astro preview",
    "cf:deploy": "bun scripts/cli.ts deploy",
    "astro": "astro",
    "typecheck": "astro check",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src scripts",
    "check": "bun run typecheck && bun run typecheck:scripts && bun run test && bun run lint",
    "ci": "bun run check && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.4",
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.1.0",
    "d3": "^7.9.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@chilfish/devkit": "0.2.0",
    "@types/bun": "^1.4.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.92.0",
    "pg": "^8.23.1",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
